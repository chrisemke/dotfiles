#!/usr/bin/env bash

set -ex

manifest="$XDG_PROJECTS_DIR/dotfiles/dev/rust/manifest.scm"
rust_dev="$XDG_DATA_HOME/rust-dev"

GUIX_CMD=(
	guix shell
	--network
	--container
	--emulate-fhs
	--manifest="$manifest"
	--share="$rust_dev/profile=$HOME/.profile"
	--share="$rust_dev/cache=$HOME/.cache"
	--share="$rust_dev/config=$HOME/.config"
	--share="$rust_dev/local=$HOME/.local"
	--share="$XDG_RUNTIME_DIR/podman/podman.sock"
	--preserve=RUSTUP_HOME="$HOME/.local/share/rustup"
	--preserve=CARGO_HOME="$HOME/.local/share/cargo"
	# In case podman is needed inside container
	# --preserve=CONTAINER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock
)

function _startup_checker() {
	# Function to check all needed files/directories.
	start="\n\e[31m rust-dev: no"
	end="\n\n Run \"rust-dev start\" first!!!\e[0m\n"
	[ -f "$manifest" ] || { echo -e "$start manifest at $manifest$end" >&2; exit 1; }
	[ -f "$rust_dev/profile" ] || { echo -e "$start profile at $rust_dev/profile$end" >&2; exit 1; }
	[ -d "$rust_dev/cache" ] || { echo -e "$start cache at $rust_dev/cache$end" >&2; exit 1; }
	[ -d "$rust_dev/config" ] || { echo -e "$start config at $rust_dev/config$end" >&2; exit 1; }
	[ -d "$rust_dev/local" ] || { echo -e "$start local at $rust_dev/local$end" >&2; exit 1; }
}

# No arguments shell will run attached;
# Argument "start" will create all needed files/directories and configs before;
# N arguments will run detached running arguments inside shell.
if [ "$#" == 0 ];
then
	_startup_checker
	exec "${GUIX_CMD[@]}" -- bash -l
elif [ "$1" == "start" ];
then
	mkdir -p $rust_dev/{cache,config,local}
	mkdir -p $rust_dev/local/share/cargo
	touch "$rust_dev/profile"
	cargo_cfg="$rust_dev/local/share/cargo/config.toml"
	if [ ! -e "$cargo_cfg" ]; then
		printf '[target.x86_64-unknown-linux-gnu]\nrustflags = ["-Clinker-features=-lld"]\n' \
					 > "$cargo_cfg"
	fi
	exec "${GUIX_CMD[@]}" -- bash -l
else
	_startup_checker
	exec "${GUIX_CMD[@]}" -- bash -l -c "$*"
fi
